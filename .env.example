# ── ResearchSwarm AI ────────────────────────────────────────────
# Copy this file to .env before running `docker compose up`.
# Every variable the backend, frontend, and compose stack read is listed
# here. Values are safe local-development defaults unless marked REQUIRED.

# ── Environment ─────────────────────────────────────────────────
ENVIRONMENT=development
APP_URL=http://localhost:3000

# ── Server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=./data/logs/research_swarm.log

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swarm:swarm@postgres:5432/research_swarm

# ── JWT Authentication ──────────────────────────────────────────
# REQUIRED outside local development. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ISSUER=researchswarm
JWT_AUDIENCE=researchswarm-api
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=7
# Comma-separated previous secrets accepted during key rotation.
JWT_SECRET_KEYS_ROTATION=

# ── Google OAuth (optional — leave blank to skip) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── CI / E2E ──────────────────────────────────────────────────────
CI=true
DEMO_URL=http://localhost:3000
E2E_FORCE=false
E2E_TEST_EMAIL=test@example.com
NODE_ENV=development
PLAYWRIGHT_BASE_URL=http://localhost:3000
SUPABASE_DB_CONTAINER=postgres

# ── LLM Provider (ollama or openrouter) ─────────────────────────
LLM_PROVIDER=ollama
# LLM_FAILOVER=true
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0

# ── Magic Links ─────────────────────────────────────────────────
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRE=15

# ── OpenRouter (required when LLM_PROVIDER=openrouter) ──────────
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=https://github.com/research-swarm

# ── Ollama ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT=30

# ── Model Routing ───────────────────────────────────────────────
PLANNER_MODEL=qwen3:14b
RESEARCH_MODEL=llama3:8b
DOCUMENT_MODEL=gemma3:12b
ANSWER_MODEL=gemma3:12b
RELEVANCE_MODEL=
EMBEDDING_MODEL=nomic-embed-text

# ── Search Backend (duckduckgo, bing, or serper) ────────────────
SEARCH_BACKEND=duckduckgo
BING_API_KEY=
SERPER_API_KEY=

# ── Supabase (production persistence + realtime bridge) ─────────
# REQUIRED in production — startup validation fails closed without these.
# The service-role key and bridge secret are SERVER-ONLY; never expose them
# through NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BRIDGE_SECRET=

# ── Vector Database ─────────────────────────────────────────────
VECTOR_DB_PATH=./data/chroma_db
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=research_swarm
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=10
RERANK_TOP_K=5

# ── File Storage ────────────────────────────────────────────────
# Options: local, s3
STORAGE_BACKEND=local
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=research-swarm-uploads
# S3_REGION=us-east-1
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Encryption ──────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Data Directories ────────────────────────────────────────────
DATA_DIR=./data
MEMORY_DIR=./data/memory

# ── Plugin Tokens (optional) ────────────────────────────────────
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_TOKEN=

# ── Frontend (also set these in your Vercel project) ────────────
# Public API base URL. Production builds fail loudly without it.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Frontend Error Tracking (optional) ──────────────────────────
# Sentry DSN for client-side error tracking. When set, captured exceptions
# are sent to Sentry. Leave unset to disable (no-op).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
