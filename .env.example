# ── ResearchSwarm AI ────────────────────────────────────────────
# Copy this file to .env before running docker compose up

# Database
DATABASE_URL=postgresql+asyncpg://swarm:swarm@postgres:5432/research_swarm

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# Google OAuth (optional — leave blank to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Provider (ollama or openrouter)
LLM_PROVIDER=ollama
# LLM_FAILOVER=true

# OpenRouter (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://ollama:11434

# Model Routing
PLANNER_MODEL=qwen3:14b
RESEARCH_MODEL=llama3:8b
DOCUMENT_MODEL=gemma3:12b
EMBEDDING_MODEL=nomic-embed-text

# Search Backend (duckduckgo, bing, or serper)
SEARCH_BACKEND=duckduckgo
BING_API_KEY=
SERPER_API_KEY=

# Server
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
