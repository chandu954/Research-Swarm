# ── ResearchSwarm AI ────────────────────────────────────────────
# Copy to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/research_swarm

# ── JWT Authentication ──────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=7

# ── Google OAuth ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── LLM Provider ────────────────────────────────────────────────
# Options: ollama (local) or openrouter (cloud)
LLM_PROVIDER=ollama

# ── Ollama (local) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30

# ── OpenRouter (cloud) ──────────────────────────────────────────
# Sign up at https://openrouter.ai and generate an API key
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=https://github.com/research-swarm

# ── Model Routing ───────────────────────────────────────────────
# When LLM_PROVIDER=ollama, use Ollama model names (e.g. qwen3:14b)
# When LLM_PROVIDER=openrouter, use OpenRouter model names (e.g. qwen/qwen3-32b)
PLANNER_MODEL=qwen3:14b
RESEARCH_MODEL=llama3:8b
DOCUMENT_MODEL=gemma3:12b
ANSWER_MODEL=gemma3:12b
EMBEDDING_MODEL=nomic-embed-text

# ── Vector Database ─────────────────────────────────────────────
VECTOR_DB_PATH=./data/chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=10
RERANK_TOP_K=5

# ── File Storage ────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./data/logs/research_swarm.log

# ── Data Directories ────────────────────────────────────────────
DATA_DIR=./data
