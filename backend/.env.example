# ── ResearchSwarm AI v3 — Multi-Tenant ──────────────────────────
# Copy to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/research_swarm

# ── JWT Authentication ──────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=7

# ── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── GitHub OAuth ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# ── Microsoft OAuth ─────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_TENANT=common

# ── Magic Links ─────────────────────────────────────────────────
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRE=15

# ── LLM Provider ────────────────────────────────────────────────
LLM_PROVIDER=ollama

# ── Ollama (local) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30

# ── OpenRouter (cloud) ──────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=https://github.com/research-swarm

# ── Model Routing ───────────────────────────────────────────────
PLANNER_MODEL=qwen3:14b
RESEARCH_MODEL=llama3:8b
DOCUMENT_MODEL=gemma3:12b
ANSWER_MODEL=gemma3:12b
EMBEDDING_MODEL=nomic-embed-text

# ── Vector Database ─────────────────────────────────────────────
VECTOR_DB_PATH=./data/chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=10
RERANK_TOP_K=5

# ── File Storage ────────────────────────────────────────────────
# Options: local, s3
STORAGE_BACKEND=local
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=research-swarm-uploads
# S3_REGION=us-east-1
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Encryption ──────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./data/logs/research_swarm.log

# ── Data Directories ────────────────────────────────────────────
DATA_DIR=./data

# ── Plugin Tokens ───────────────────────────────────────────────
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_TOKEN=
