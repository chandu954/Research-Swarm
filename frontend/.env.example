# ── ResearchSwarm Frontend — environment variables ─────────────────
# Copy to .env.local for local development. For production, set these in
# your Vercel project dashboard (Production + Preview scopes) — never
# commit real values.

# Public API base URL of the deployed backend (FastAPI service on
# Railway/Render). REQUIRED for production builds: without it the app
# fails loudly instead of silently pointing at localhost.
# Development default (no env): http://localhost:8000
NEXT_PUBLIC_API_URL=https://your-backend-host.example.com

# Public Supabase project configuration. Create a Supabase project and
# use its project URL + anon (publishable) key. NEVER put the service-role
# key in a NEXT_PUBLIC_* variable — it is exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: the FastAPI backend requires its own server-side configuration —
# see backend/.env.example (DATABASE_URL, JWT_SECRET_KEY,
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_BRIDGE_SECRET, OPENROUTER_API_KEY,
# CORS_ORIGINS, OAuth client IDs/secrets, ...).
