# ── ResearchSwarm Frontend — environment variables ─────────────────
# Copy to .env.local for local development. For production, set these in
# your Vercel project dashboard (Production + Preview scopes) — never
# commit real values.

# Public API base URL of the backend (FastAPI service on Railway/Render).
# Use http://localhost:8000 for local development. Production builds require
# the deployed HTTPS URL and fail loudly if it still points at localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Supabase project configuration. Leave blank for local development
# without Supabase-backed realtime; fill both values to enable it. Production
# builds require a real project URL and anon (publishable) key. NEVER put the
# service-role key in a NEXT_PUBLIC_* variable — it is exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: the FastAPI backend requires its own server-side configuration —
# see backend/.env.example (DATABASE_URL, JWT_SECRET_KEY,
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_BRIDGE_SECRET, OPENROUTER_API_KEY,
# CORS_ORIGINS, OAuth client IDs/secrets, ...).
